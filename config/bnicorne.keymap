#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BAS_L 0
#define M_L 1
#define OH_L 2
#define CMD_L 3
#define NAV_L 4
#define NUM_L 5
#define WIN_L 6
#define BOOT_L 7

#define MOUSE_SPEED 1500
#define MOUSE_FAST 1500
#define MOUSE_SLOW 120
#define MOUSE_SCROLL_SPEED 50
#define MOUSE_TAPPING_TERM 180

/ {

        behaviors {
          ht_hp: holdtap_tapreferred {
              compatible = "zmk,behavior-hold-tap";
              label = "HOMEROW_MODS";
              #binding-cells = <2>;
              tapping-term-ms = <400>;
              flavor = "tap-preferred";
              bindings = <&kp>, <&kp>;
          };
          mmv {
              trigger-period-ms = <16>;      // ≈ MOUSEKEY_INTERVAL 16
              delay-ms = <20>;                // ≈ MOUSEKEY_DELAY 0
              time-to-max-speed-ms = <800>;  // smoother than QMK’s 40ms steps
              acceleration-exponent = <0>;
          };
          mouse_mt: mouse_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mmv>, <&mmv>;
          };
          mouse_move_right_slow: mouse_move_right_slow {
                compatible = "zmk,behavior-mouse-move";
                x = <MOUSE_SLOW>;
                y = <0>;
          };

          mouse_move_right_fast: mouse_move_right_fast {
                compatible = "zmk,behavior-mouse-move";
                x = <MOUSE_FAST>;
                y = <0>;
          };

          mouse_move_right: mouse_move_right {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <0>;
                tapping-term-ms = <MOUSE_TAPPING_TERM>;
                flavor = "tap-preferred";
                bindings = <
                  &mouse_move_right_slow
                  &mouse_move_right_fast
                >;
          };
        };

        conditional_layers {
          compatible = "zmk,conditional-layers";
          tri_layer {
                if-layers = <CMD_L NAV_L>;
                then-layer = <WIN_L>;
          };
        };

        keymap {
                compatible = "zmk,keymap";
                base_layer {
                    label = "Base";
                    bindings = <
        &mo BOOT_L  &kp LG(LALT)  &kp W           &kp E         &kp R           &kp T   &kp Y   &kp U           &kp I         &kp O         &none   &mo BOOT_L
        &kp Q       &kp A         &ht_hp LALT S   &ht_hp LGUI D &ht_hp LCTRL F  &kp G   &kp H   &ht_hp LCTRL J  &ht_hp LGUI K &ht_hp LALT L &kp P   &kp SEMI
        &kp CAPS    &kp Z         &kp X           &kp C         &kp V           &kp B   &kp N   &kp M           &kp COMMA     &kp DOT       &kp SQT &kp RSHIFT
        &mo NUM_L &kp LSHFT &mo CMD_L &kp SPACE &mo NAV_L &none
                    >;
                };
            mouse_layer {
              label = "Mouse";
              bindings = <

        &none &none   &none   &none   &none     &none   &none           &none           &none           &none             &none         &none
        &none &none   &none   &none   &none  &none   &msc MOVE_Y(-MOUSE_SCROLL_SPEED)  &msc SCRL_RIGHT &mmv MOVE_Y(-MOUSE_FAST)    &msc SCRL_LEFT    &none         &none
        &none &none   &none   &none   &none     &none  &msc MOVE_Y(MOUSE_SCROLL_SPEED) &mouse_mt MOVE_X(-MOUSE_SLOW) MOVE_X(-MOUSE_FAST)    &mmv MOVE_Y(MOUSE_FAST)  &mouse_move_right &mkp RCLK     &none
        &trans  &trans  &trans  &mkp LCLK &trans  &none
                    >;
            };
            one_hand_layer {
              label = "OneHand";
              bindings = <
        &none &none &none &none   &none     &none   &none &none         &none     &none         &none         &none
        &none &none &none &none   &none     &none   &none &kp LC(LEFT)  &kp UP    &kp LC(RIGHT) &none         &none
        &none &none &none &none   &none     &none   &none &kp LEFT      &kp DOWN  &kp RIGHT     &kp LG(BSPC)  &none
        &none &none &trans  &kp SPACE &trans  &none
                    >;
            };
                left_cmd_layer {
                    label = "Cmd";
                    bindings = <
        &kp LC(LG(Q)) &none     &kp LG(LS(Z)) &kp LG(W) &kp LG(R) &kp LG(T) &kp CARET     &kp AMPS &kp LPAR  &kp RPAR  &none &kp LC(F8)
        &kp LG(TAB)   &kp LG(A) &kp TAB       &to BAS_L &kp ESC   &kp LG(F) &kp ASTRK     &kp BSPC &kp LC(X) &kp MINUS &kp COLON &none
        &kp LS(TAB)   &kp LG(Z) &kp LG(X)     &kp LC(C) &kp LG(C) &kp LG(V) &kp LA(LG(V)) &kp LBKT &kp RBKT  &kp UNDER &none   &kp RSHIFT
        &none &none &none &kp ENTER &mo NAV_L &none
                    >;
                };

                right_nav_layer {
                    label = "Nav";
                    bindings = <
        &kp LC(F3)      &none       &none           &kp LBRC    &kp RBRC   &none     &kp LG(GRAVE) &kp LA(LG(Y))  &kp UP    &kp EQUAL &none     &none
        &none           &kp LG(N1)  &kp LS(LC(TAB)) &kp LC(TAB) &kp DOLLAR &kp PRCNT &kp LS(LG(C)) &kp LEFT       &kp DOWN  &kp RIGHT &kp LG(Y) &kp LG(BSPC)
        &kp LG(LS(T))   &kp EXCL    &kp AT          &kp HASH    &kp TILDE  &kp GRAVE &kp LS(LG(N)) &kp BSLH       &to M_L   &kp SLASH &none     &to OH_L
        &none &kp LSHFT &mo CMD_L &none &none &none
                    >;
                };

                left_num_layer {
                    label = "Num";
                    bindings = <
        &kp LG(BSPC)  &none  &kp LC(LS(PG_UP))  &kp LG(LS(N5))      &kp LC(LS(PG_DN)) &none         &none       &kp N7 &kp N8 &kp N9  &none   &kp K_MUTE
        &none         &none  &kp LG(LBKT)       &kp LC(LG(LS(N4)))  &kp LG(RBKT)      &kp LS(LG(G)) &kp PG_UP   &kp N4 &kp N5 &kp N6  &kp DOT &kp K_VOLUME_UP
        &none         &none  &none              &kp LG(LS(N4))      &none             &none         &kp PG_DN   &kp N1 &kp N2 &kp N3  &none   &kp K_VOLUME_DOWN
        &none                    &none          &none              &kp LS(ENTER)   &kp N0 &none
                    >;
                };
                window_layer {
                    label = "WindowManagement";
                    bindings = <
        &kp LS(LA(Z))       &none               &none               &kp LG(LA(LS(L)))       &kp LG(LA(LS(H)))       &none             &none &kp LC(LEFT)  &kp LC(UP)        &kp LC(RIGHT)   &none  &none
        &kp LC(N1)          &kp LC(N2)          &kp LC(N3)          &kp LC(N4)          &kp LC(N5)          &kp LA(LS(SPACE))
        &none &kp LG(LA(LS(J))) &kp LA(LS(ENTER)) &kp LG(LA(LS(K)))   &none  &kp LS(LA(M))
        &kp LC(LS(LA(N1)))  &kp LC(LS(LA(N2)))  &kp LC(LS(LA(N3)))  &kp LC(LS(LA(N4)))  &kp LC(LS(LA(N5)))  &kp LA(LS(T))     &none &none         &none             &none           &none  &none
        &none &none &none &none &none &none
                    >;
                };
                boot_layer {
                    label = "bootloader";
                    bindings = <
                        &none         &none         &bt BT_PRV    &bt BT_NXT    &bt BT_CLR    &none &none &none &none &none &none &none
                        &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none &none &none &none &none &none &none
                        &none &none &none &none &none &none &none &none &none &none &none &none
                                    &bootloader &none &none &none &none &bootloader
                    >;
                };
        };
};
